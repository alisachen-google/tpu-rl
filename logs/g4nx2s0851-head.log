  '\\documentclass[11pt]{article}\n\\usepackage[utf8]{inputenc}\n\\usepackage{amsmath}\n\\usepackage{amssymb}\n\\usepackage{amsfonts}\n\\usepackage{amsthm}\n\\usepackage{hyperref}\n\\usepackage{graphicx}\n\\usepackage{float}\n\\usepackage{geometry}\n\n\\title{Problem Solving: Vector Addition and Scalar Multiplication}\n\\author{My Name}\n\n\\begin{document}\n\n\\maketitle\n\n\\begin{problem}\nGiven vectors $\\mathbf{a} = \\begin{pmatrix} 2 \\\\ -3 \\\\ 1 \\end{pmatrix}$ and $\\mathbf{b} = \\begin{pmatrix} 1 \\\\ -2 \\\\ 2 \\end{pmatrix}$, find the vector $\\mathbf{c}$ such that $\\mathbf{c} + 2 \\mathbf{a} = 5 \\mathbf{b}$.\n\\end{problem}\n\n\\begin{solution}\nLet $\\mathbf{c} = \\begin{pmatrix} x \\\\ y \\\\ z \\end{pmatrix}$. Then, we have:\n\\[\n\\mathbf{c} + 2 \\mathbf{a} = \\mathbf{c} + 2 \\begin{pmatrix} 2 \\\\ -3 \\\\ 1 \\end{pmatrix} = \\begin{pmatrix} x + 2 \\cdot 2 \\\\ y + 2 \\cdot (-3) \\\\ z + 2 \\cdot 1 \\end{pmatrix}\n\\]\n\\[\n= \\begin{pmatrix} x + 4 \\\\ y - 6 \\\\ z + 2 \\end{pmatrix}\n\\]\n\\[\n= \\begin{pmatrix} 5 \\\\ -12 \\\\ 3 \\end{pmatrix}\n\\]\n\nSince $\\mathbf{c} + 2 \\mathbf{a} = \\mathbf{c} + 2 \\begin{pmatrix} 2 \\\\ -3 \\\\ 1 \\end{pmatrix}$, we can conclude that $\\mathbf{c} = \\begin{pmatrix} 5 \\\\ -12 \\\\ 3 \\end{pmatrix}$.\n\\end{solution}\n\n\\end{document}\n<unused56><eos>'
