diff --git a/python/sglang/srt/disaggregation/prefill.py b/python/sglang/srt/disaggregation/prefill.py
index 275607786a..74816e799b 100644
--- a/python/sglang/srt/disaggregation/prefill.py
+++ b/python/sglang/srt/disaggregation/prefill.py
@@ -1219,7 +1219,14 @@ class SchedulerDisaggregationPrefillMixin:
         maybe_release_metadata_buffer(req, self.req_to_metadata_buffer_idx_allocator)
         req.pending_bootstrap = False
         self.tree_cache.finish(req.cache_request_handle, CacheRequestOutcome.ABORT)
-        if req.kv.holds_kv or req.kv.holds_mamba:
+        # process_pending_chunked_abort may have parked this request until the
+        # raiden transfer group is quiescent; _drain_deferred_chunked_sender_aborts
+        # then owns the single release. Releasing here as well frees the row
+        # twice, and the second release asserts.
+        parked_for_drain = any(
+            held is req for held in self._deferred_chunked_sender_aborts
+        )
+        if (req.kv.holds_kv or req.kv.holds_mamba) and not parked_for_drain:
             release_kv_cache(req, self.tree_cache, is_insert=False)
         return True
 
