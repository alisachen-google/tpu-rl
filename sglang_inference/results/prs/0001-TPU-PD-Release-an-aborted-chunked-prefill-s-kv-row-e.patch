+) -> Scheduler:
     sched = Scheduler.__new__(Scheduler)
     sched.chunked_req = chunked_req
     sched._pending_chunked_abort_req = pending_req
@@ -41,11 +80,15 @@ def _make_scheduler(pending_req, *, chunked_req, running_reqs) -> Scheduler:
     sched.waiting_queue = []
