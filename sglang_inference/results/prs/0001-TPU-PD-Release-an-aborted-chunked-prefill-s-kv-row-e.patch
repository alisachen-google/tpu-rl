+def _release(req, tree_cache, is_insert=True):
+    """Stand-in for release_kv_cache with the real precondition."""
+    assert req.kv.holds_kv, f"{req.rid}: kv row released twice"
+    req.kv.holds_kv = False
+
+
+class TestChunkedAbortDeferredRelease(CustomTestCase):
+    """A chunked-prefill abort whose raiden sender must drain releases its kv row once.
+
+    Regression for ``AssertionError: Only a mamba-capable tree cache allows
+    freeing before alloc``: ``process_pending_chunked_abort`` parked the request
+    on the deferred drain list, the in-flight chunk's result then retired it
+    (freeing the row), and the drain freed it a second time.
+    """
+
+    def setUp(self):
+        enter_scope(self, published_topology())
+        patches = [
+            patch(
+                "sglang.srt.managers.scheduler.release_kv_cache", side_effect=_release
+            ),
+            patch(
+                "sglang.srt.disaggregation.prefill.release_kv_cache",
+                side_effect=_release,
+            ),
+            patch(
+                "sglang.srt.managers.scheduler._make_abort_req",
+                side_effect=lambda req, *a, **k: Mock(),
+            ),
+        ]
+        self.release_sched, self.release_prefill, _ = [p.start() for p in patches]
+        for p in patches:
+            self.addCleanup(p.stop)
+
+    def _releases(self) -> int:
+        return self.release_sched.call_count + self.release_prefill.call_count
+
+    def _prefill_scheduler(self, req) -> Scheduler:
+        return _make_scheduler(
+            req,
+            chunked_req=req,
+            running_reqs=[],
+            disaggregation_mode=DisaggregationMode.PREFILL,
+        )
+
+    def test_drain_required_release_happens_once_in_drain(self):
+        sender = _FakeSender(requires_drain=True, polls_until_drained=2)
+        req = _FakeReq("chunked", sender)
+        req.metadata_buffer_index = 3
+        sched = self._prefill_scheduler(req)
+
+        # Step N: the abort is applied at the top of the scheduling step.
+        sched.process_pending_chunked_abort()
+        self.assertEqual(sched._deferred_chunked_sender_aborts, [req])
+        self.assertEqual(
+            self._releases(), 0, "pages must stay allocated until raiden drains"
+        )
+        self.assertTrue(req.kv.holds_kv)
+        self.assertEqual(req.metadata_buffer_index, -1)
+        self.assertEqual(sender.abort_calls, 1)
+
+        # Step N, later: the in-flight chunk's result lands and retires the request.
+        self.assertTrue(sched._retire_aborted_prefill_result(req))
+        self.assertEqual(
+            self._releases(), 0, "retirement must not free pages the drain owns"
+        )
+        self.assertTrue(req.kv.holds_kv)
+        self.assertTrue(req.finished())
+
+        # Steps N+1, N+2: the drain polls until the sender is quiescent, then frees once.
+        sched.process_pending_chunked_abort()  # poll 1: still held
+        self.assertEqual(sched._deferred_chunked_sender_aborts, [req])
+        self.assertEqual(self._releases(), 0)
+        sched.process_pending_chunked_abort()  # poll 2: drained
+        self.assertEqual(sched._deferred_chunked_sender_aborts, [])
+        self.assertEqual(self._releases(), 1)
+        self.assertFalse(req.kv.holds_kv)
+        self.assertEqual(sender.clear_calls, 1)
+
+        # Idempotent afterwards.
+        sched.process_pending_chunked_abort()
+        self.assertEqual(self._releases(), 1)
+
+    def test_retire_in_same_step_then_drain_is_single_release(self):
+        """Result lands in the step of the abort (overlap off): still one release."""
+        sender = _FakeSender(requires_drain=True, polls_until_drained=1)
+        req = _FakeReq("same_step", sender)
+        sched = self._prefill_scheduler(req)
+        sched.process_pending_chunked_abort()
+        self.assertTrue(sched._retire_aborted_prefill_result(req))
+        sched.process_pending_chunked_abort()
+        self.assertEqual(self._releases(), 1)
+        self.assertEqual(sched._deferred_chunked_sender_aborts, [])
+
+    def test_no_drain_required_releases_immediately_and_retire_is_noop(self):
+        sender = _FakeSender(requires_drain=False, polls_until_drained=0)
+        req = _FakeReq("immediate", sender)
+        sched = self._prefill_scheduler(req)
+        sched.process_pending_chunked_abort()
+        self.assertEqual(self._releases(), 1)
+        self.assertFalse(req.kv.holds_kv)
+        self.assertEqual(sched._deferred_chunked_sender_aborts, [])
+        # The chunk result may still arrive; nothing is owned any more.
+        self.assertFalse(sched._retire_aborted_prefill_result(req))
+        self.assertEqual(self._releases(), 1)
+
+    def test_already_drained_sender_releases_at_abort_time(self):
+        sender = _FakeSender(requires_drain=True, polls_until_drained=0)
+        req = _FakeReq("drained", sender)
+        sched = self._prefill_scheduler(req)
+        sched.process_pending_chunked_abort()
+        self.assertEqual(self._releases(), 1)
+        self.assertEqual(sched._deferred_chunked_sender_aborts, [])
+        self.assertFalse(sched._retire_aborted_prefill_result(req))
+        self.assertEqual(self._releases(), 1)
+
+    def test_drain_tolerates_row_already_freed(self):
+        """Defensive guard: a parked request whose row is gone must not assert."""
+        sender = _FakeSender(requires_drain=True, polls_until_drained=0)
+        req = _FakeReq("gone", sender)
+        req.kv.holds_kv = False
+        sched = _make_scheduler(None, chunked_req=None, running_reqs=[])
+        sched._deferred_chunked_sender_aborts = [req]
+        sched._drain_deferred_chunked_sender_aborts()
+        self.assertEqual(self._releases(), 0)
+        self.assertEqual(sched._deferred_chunked_sender_aborts, [])
+        self.assertEqual(sender.clear_calls, 1)
+
+    def test_two_parked_requests_release_independently(self):
+        fast = _FakeReq(
+            "fast", _FakeSender(requires_drain=True, polls_until_drained=1)
+        )
+        slow = _FakeReq(
+            "slow", _FakeSender(requires_drain=True, polls_until_drained=3)
+        )
+        sched = _make_scheduler(None, chunked_req=None, running_reqs=[])
+        sched._deferred_chunked_sender_aborts = [fast, slow]
+        sched._drain_deferred_chunked_sender_aborts()
+        self.assertEqual(sched._deferred_chunked_sender_aborts, [slow])
+        self.assertFalse(fast.kv.holds_kv)
+        self.assertTrue(slow.kv.holds_kv)
+        sched._drain_deferred_chunked_sender_aborts()
+        sched._drain_deferred_chunked_sender_aborts()
+        self.assertEqual(sched._deferred_chunked_sender_aborts, [])
+        self.assertEqual(self._releases(), 2)
+
+
 if __name__ == "__main__":
     unittest.main(verbosity=2)
