+class _FakeSender:
+    """Raiden-like kv sender: the group needs a drain and drains after N polls."""
+
+    def __init__(self, *, requires_drain: bool, polls_until_drained: int):
+        self.group_failure_requires_drain = requires_drain
+        self._polls_left = polls_until_drained
+        self.abort_calls = 0
+        self.clear_calls = 0
+
+    def abort(self):
+        self.abort_calls += 1
+
+    def poll(self):
+        self._polls_left = max(0, self._polls_left - 1)
+
+    def drained(self) -> bool:
+        return self._polls_left == 0
+
+    def clear(self):
+        self.clear_calls += 1
+
+
 class _FakeReq:
     """Minimal stand-in for Req: only the fields the abort paths touch."""
 
-    def __init__(self, rid: str):
+    def __init__(self, rid: str, sender: _FakeSender | None = None):
         self.rid = rid
         # Mirrors Req.kv; the abort paths read only these two predicates.
         self.kv = SimpleNamespace(holds_kv=True, holds_mamba=False)
         self.to_finish = None
+        self.finished_reason = None
+        self.return_logprob = False
+        self.metadata_buffer_index = -1
+        self.pending_bootstrap = True
+        self.cache_request_handle = object()
+        self.disagg_kv_sender = sender
+        self.time_stats = SimpleNamespace(
+            trace_ctx=Mock(), set_completion_time=Mock()
+        )
+        self.output_ids = []
         self._finished = False
 
     def finished(self):
-        return self._finished
+        # Mirrors Req.finished(): prepare_abort sets finished_reason.
+        return self._finished or self.finished_reason is not None
 
+    def update_finish_state(self):
+        self._finished = True
 
