+@patch("sglang.srt.disaggregation.prefill.release_kv_cache", side_effect=_free_req)
+def test_aborted_result_parked_for_sender_drain_keeps_kv_row(release_kv_cache):
+    """process_pending_chunked_abort parked the request until raiden drains; the
+    result retirement must finish the request without freeing the row, which
+    the drain then releases exactly once (double free asserted in ChunkCache)."""
+    scheduler = _Scheduler()
+    req = _Req(inflight_middle_chunks=0)
+    scheduler._deferred_chunked_sender_aborts = [req]
+
+    scheduler.process_batch_result_disagg_prefill(_batch(req), _result())
+
+    release_kv_cache.assert_not_called()
+    assert req.kv.holds_kv
+    assert req.finished()
+    assert req.metadata_buffer_index == -1
+    scheduler.output_streamer.stream_output.assert_called_once_with([req], False)
+    assert req.rid not in scheduler.disagg_prefill_pending_chunk_rids
+    # The drain owns the release; nothing else touches the row afterwards.
+    scheduler.process_batch_result_disagg_prefill(_batch(req), _result())
+    release_kv_cache.assert_not_called()
+
