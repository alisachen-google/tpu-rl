diff --git a/python/sglang/srt/disaggregation/prefill.py b/python/sglang/srt/disaggregation/prefill.py
index 275607786a..d2cdd9d693 100644
--- a/python/sglang/srt/disaggregation/prefill.py
+++ b/python/sglang/srt/disaggregation/prefill.py
@@ -929,10 +929,12 @@ class SchedulerDisaggregationPrefillMixin:
                         continue
 
                 self.cache_unfinished_disagg_prefill(req)
-                if (
-                    self.transfer_backend == TransferBackend.RAIDEN
-                    and get_parallel().pp_size > 1
-                ):
+                if self.transfer_backend == TransferBackend.RAIDEN:
+                    # Raiden's SWA payload is the window only (``_swa_payload``),
+                    # so the pages beyond it are dead once prefill finishes. A
+                    # request waiting for the decode to pull otherwise keeps a
+                    # whole chunk of the SWA pool, and the next chunked prefill's
+                    # continuation budget drops to 0 with no eviction to raise it.
                     self._release_swa_beyond_window(req)
                 self.disagg_prefill_inflight_queue.append(req)
                 if self.spec_algorithm.is_eagle() and draft_input is not None:
@@ -1387,7 +1389,7 @@ class SchedulerDisaggregationPrefillMixin:
 
     def _release_swa_beyond_window(self: Scheduler, req: Req) -> None:
         """Free a finished prefill's SWA KV outside the sliding window while the
-        transfer is pending; the Raiden pipeline transfer reads the window only."""
+        transfer is pending; Raiden transfers read the window only."""
         if not (self.tree_cache.is_chunk_cache() and self.tree_cache.supports_swa()):
             return
         free_swa_out_of_window_slots(
