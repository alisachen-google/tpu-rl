+def test_hybrid_serves_hbm_only_and_window_pages():
+    prefill, decode = pair()
+    swa = FakeEngine()
+    decode._swa_engine = swa
+    decode.swa_raiden_endpoint = "decode-swa"
+    tree = FakeTree(device_tokens=16, host_tokens=8)
