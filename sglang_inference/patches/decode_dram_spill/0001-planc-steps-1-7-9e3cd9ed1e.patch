+class FakeAllocator:
+    def __init__(self):
+        self.page_size = PAGE
+        self.freed = []
+        self.next = 3000
+
+    def alloc_extend(self, pl, plc, sl, slc, last_loc, n):
+        out = torch.arange(self.next, self.next + n, dtype=torch.int32)
