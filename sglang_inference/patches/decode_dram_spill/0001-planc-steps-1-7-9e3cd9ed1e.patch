+    queue.scheduler.waiting_queue = ["computing"]
+    monkeypatch.setattr(hook, "_min_tokens", lambda page_size: PAGE)
+    monkeypatch.setattr(
+        hook,
+        "_match_prefix_result",
+        lambda tree, req, tokens: tree.match_prefix(
